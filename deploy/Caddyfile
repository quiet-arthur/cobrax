# Caddy obtém e renova o certificado HTTPS sozinho (Let's Encrypt).
# Só /webhook e /health são expostos; o resto responde 404.
api.laeltonrenato.com.br {
	request_body {
		max_size 1MB
	}

	@app path /webhook /health
	handle @app {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		respond 404
	}

	# O handshake da Meta traz o verify token na query string: o filtro troca
	# o valor antes de gravar o log de acesso (nas duas formas que a Meta usa).
	log {
		format filter {
			request>uri query {
				replace hub.verify_token REDACTED
				replace hub_verify_token REDACTED
			}
		}
	}
}
